{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:script && npm run build:cp",
        "build:script": "esbuild resources/ts/doormat.ts --bundle --format=iife --target=es2019 --minify --legal-comments=none --outfile=resources/dist/doormat.js",
        "build:cp": "vite build",
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "@statamic/cms": "file:./vendor/statamic/cms/resources/dist-package",
        "esbuild": "^0.28.2",
        "happy-dom": "^21.0.3",
        "laravel-vite-plugin": "^3.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.0",
        "vitest": "^5.0.5"
    }
}
